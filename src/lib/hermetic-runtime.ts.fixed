import { spawn, ChildProcess } from "child_process";
import path from "path";
import fs from "fs-extra";

/**
 * 🚀 Hermetic Runtime Management for Applaa
 * 
 * This module provides isolated runtime environments for different app types,
 * ensuring consistent behavior across development environments.
 * 
 * Features:
 * - 📦 Package Manager Detection & Optimization
 * - 🎯 Dependency Pre-caching & CDN Fallbacks  
 * - 🤖 AI Model Caching for Transformers.js
 * - 🔧 Native Module Rebuilding
 * - 📱 Expo/React Native Optimization
 * - 🌐 Web Bundle Optimization
 */

// Logger interface for consistent logging
interface Logger {
  info: (message: string) => void;
  warn: (message: string) => void;
  error: (message: string, error?: any) => void;
  debug: (message: string) => void;
  log: (message: string) => void;
}

// Create a simple logger if none is provided
const logger: Logger = {
  info: (msg) => console.log(`[hermetic-runtime] ${msg}`),
  warn: (msg) => console.warn(`[hermetic-runtime] ${msg}`),
  error: (msg, err) => console.error(`[hermetic-runtime] ${msg}`, err || ''),
  debug: (msg) => console.debug(`[hermetic-runtime] ${msg}`),
  log: (msg) => console.log(`[hermetic-runtime] ${msg}`)
};

/**
 * 🎯 PERFORMANCE: Detect the best package manager for the project
 */
export async function getBestPackageManager(projectPath: string): Promise<"npm" | "yarn" | "pnpm"> {
  // Check for lock files to determine the preferred package manager
  const lockFiles = [
    { file: "pnpm-lock.yaml", manager: "pnpm" as const },
    { file: "yarn.lock", manager: "yarn" as const },
    { file: "package-lock.json", manager: "npm" as const },
  ];

  for (const { file, manager } of lockFiles) {
    if (fs.existsSync(path.join(projectPath, file))) {
      return manager;
    }
  }

  // Default to npm if no lock file is found
  return "npm";
}

/**
 * 🚀 PERFORMANCE: Check if pnpm is available and install if needed
 */
export async function ensurePnpmAvailable(): Promise<boolean> {
  return new Promise((resolve) => {
    const checkProcess = spawn("pnpm", ["--version"], { shell: true, stdio: "ignore" });
    
    checkProcess.on("close", (code) => {
      if (code === 0) {
        resolve(true);
      } else {
        logger.info("Installing pnpm globally for better performance...");
        const installProcess = spawn("npm", ["install", "-g", "pnpm"], { 
          shell: true, 
          stdio: "ignore" 
        });
        
        installProcess.on("close", (installCode) => {
          resolve(installCode === 0);
        });
        
        installProcess.on("error", () => {
          resolve(false);
        });
      }
    });
    
    checkProcess.on("error", () => {
      resolve(false);
    });
  });
}

