{
  "dependencies": {
    "@expo/config-plugins": "~8.0.0"
  },
  "description": "Applaa configuration plugin for branding, permissions, and optimizations",
  "features": [
    "Applaa branding and attribution",
    "Automatic permission management",
    "AI performance optimizations", 
    "Asset generation integration",
    "Feature-based configuration"
  ],
  "configUpdates": {
    "app.json": {
      "plugins": [
        [
          "./plugins/applaa-config-plugin",
          {
            "branding": {
              "showApplaaAttribution": true
            },
            "performance": {
              "enableOptimizations": true,
              "targetDevices": ["phone", "tablet"]
            },
            "features": []
          }
        ]
      ]
    }
  }
}


