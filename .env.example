# Applaa Environment Variables Template
# ⚠️ IMPORTANT: This is a template file. Copy to .env and fill with your actual keys.
# ⚠️ NEVER commit .env file to Git - it contains real secrets!

# ===== AZURE OPENAI CONFIGURATION =====
# Get these from your Azure OpenAI resource in Azure Portal
AZURE_API_KEY=your-azure-openai-api-key-here
AZURE_RESOURCE_NAME=your-azure-openai-resource-name
AZURE_DEPLOYMENT_NAME=your-deployment-name
AZURE_API_VERSION=2024-02-01
AZURE_ENDPOINT=https://your-resource-name.openai.azure.com/

# ===== SUPABASE CONFIGURATION =====
# Get these from your Supabase project dashboard
SUPABASE_URL=https://your-project-id.supabase.co
AUTH_SUPABASE_URL=https://your-project-id.supabase.co
AUTH_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ===== CLOUDFLARE R2 CONFIGURATION =====
# Get these from your Cloudflare R2 dashboard
CLOUDFLARE_R2_ACCOUNT_ID=your-account-id-here
CLOUDFLARE_R2_ACCESS_KEY_ID=your-access-key-id-here
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-secret-access-key-here
CLOUDFLARE_R2_BUCKET_NAME=applaa-user-storage
CLOUDFLARE_R2_REGION=auto

# ===== ANALYTICS CONFIGURATION =====
# Google Analytics 4
GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Sentry for error tracking
SENTRY_DSN=https://your-sentry-dsn-here

# ===== FEATURE FLAGS =====
# Enable/disable MVP features
ENABLE_CLOUD_SYNC=true
ENABLE_ANALYTICS=true
ENABLE_CRASH_REPORTING=true

# ===== DEVELOPMENT SETTINGS =====
NODE_ENV=development
LOG_LEVEL=info

# ===== VERCEL DEPLOYMENT =====
VITE_VERCEL_TOKEN=your-vercel-token-here
VITE_GITHUB_TOKEN=your-github-personal-access-token-here

# ===== E2B CODE EXECUTION =====
E2B_API_KEY=your-e2b-api-key-here

# ===== APPLE NOTARIZATION (macOS builds only) =====
APPLE_ID=your-apple-id@example.com
APPLE_PASSWORD=your-app-specific-password-here
APPLE_TEAM_ID=YOUR_TEAM_ID
MAC_NOTARIZE=true

# ===== LLM PROVIDER API KEYS =====
# Google Gemini API
GOOGLE_API_KEY=your-google-api-key-here

# Anthropic Claude API
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OpenRouter API
OPENROUTER_API_KEY=your-openrouter-api-key-here

# OpenAI API
OPENAI_API_KEY=your-openai-api-key-here
