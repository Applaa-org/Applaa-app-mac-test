#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🛡️  Running pre-commit tests..."

# Run core tests (fast)
npm run test:core

# Check if tests passed
if [ $? -ne 0 ]; then
  echo "💥 Core tests failed! Commit blocked."
  echo "🔧 Please fix the issues and try again."
  exit 1
fi

echo "✅ Pre-commit tests passed!"