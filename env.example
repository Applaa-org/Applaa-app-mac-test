# ===== SUPABASE CONFIGURATION (For Backend Integration) =====
# Get these from your Supabase project dashboard
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ===== WORDPRESS AUTHENTICATION =====
# WordPress authentication for the app (works with your existing WordPress setup)
WORDPRESS_URL=https://your-wordpress-site.com

# ===== CLOUDFLARE R2 CONFIGURATION =====
# Get these from your Cloudflare R2 dashboard
CLOUDFLARE_R2_ACCOUNT_ID=your-account-id-here
CLOUDFLARE_R2_ACCESS_KEY_ID=your-access-key-id-here
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-secret-access-key-here
CLOUDFLARE_R2_BUCKET_NAME=applaa-user-storage
CLOUDFLARE_R2_REGION=auto

# ===== ANALYTICS CONFIGURATION =====
# Google Analytics 4
GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Sentry for error tracking
SENTRY_DSN=https://your-sentry-dsn-here

# ===== FEATURE FLAGS =====
# Enable/disable MVP features
ENABLE_CLOUD_SYNC=true
ENABLE_ANALYTICS=true
ENABLE_CRASH_REPORTING=true

# ===== DEVELOPMENT SETTINGS =====
NODE_ENV=development
LOG_LEVEL=info

