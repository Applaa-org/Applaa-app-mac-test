# Applaa MVP Environment Configuration

# ===== AZURE OPENAI CONFIGURATION =====
# Get these from your Azure OpenAI resource in Azure Portal
AZURE_API_KEY=your-azure-openai-api-key-here
AZURE_RESOURCE_NAME=your-azure-openai-resource-name
AZURE_DEPLOYMENT_NAME=your-deployment-name
AZURE_API_VERSION=2024-02-01
AZURE_ENDPOINT=https://your-resource-name.openai.azure.com/

# ===== SUPABASE CONFIGURATION =====
# Get these from your Supabase project dashboard
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ===== CLOUDFLARE R2 CONFIGURATION =====
# Get these from your Cloudflare R2 dashboard
CLOUDFLARE_R2_ACCOUNT_ID=your-account-id-here
CLOUDFLARE_R2_ACCESS_KEY_ID=your-access-key-id-here
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-secret-access-key-here
CLOUDFLARE_R2_BUCKET_NAME=applaa-user-storage
CLOUDFLARE_R2_REGION=auto

# ===== ANALYTICS CONFIGURATION =====
# Google Analytics 4
GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Sentry for error tracking
SENTRY_DSN=https://your-sentry-dsn-here

# ===== FEATURE FLAGS =====
# Enable/disable MVP features
ENABLE_CLOUD_SYNC=true
ENABLE_ANALYTICS=true
ENABLE_CRASH_REPORTING=true

# ===== DEVELOPMENT SETTINGS =====
NODE_ENV=development
LOG_LEVEL=info

